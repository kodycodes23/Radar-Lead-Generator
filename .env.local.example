# Copy this file to .env.local and fill in real values. .env.local is
# already gitignored by the Next.js scaffold -- never commit real keys.

# Claude Agent SDK / Anthropic API key. The agent runtime uses this to run
# the ICP-refinement, qualification, and copywriting reasoning.
ANTHROPIC_API_KEY=

# Apify team account token (NOT your personal account -- see PRD.md "Apify
# Usage Limits". Switch to the team account in the Apify Console first).
APIFY_API_TOKEN=

# Firecrawl API key, for website scraping.
FIRECRAWL_API_KEY=

# Supabase project. Use the SERVICE ROLE key here (server-only -- this file
# must never be imported by client code). Run supabase/schema.sql in the
# Supabase SQL Editor before starting the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
